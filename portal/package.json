{
  "name": "portal",
  "private": true,
  "scripts": {
    "startp": "turbo run dev --parallel",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "proxy": "node local-proxy.js",
    "dev:all": "pnpm -w -r --parallel run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:build": "docker compose up"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "shell": "^0.1.0",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "MIT"
}
